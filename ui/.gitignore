# Generated by the TanStack Router vite plugin on every build (build.rs runs
# `pnpm build` before the Rust build, and the Dockerfile does the same). Keeping
# it tracked meant any native build left the checkout dirty, which aborted
# deployment via the clean-tree guard in scripts/deploy-local.sh.
